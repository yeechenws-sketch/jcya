<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chat.older.xiechen.dao.MedicineInfoMapper">
    <resultMap id="MedicineInfoResultMap" type="com.chat.older.xiechen.model.MedicineInfo">
        <id property="id" column="id"/>
        <result property="type" column="type"/>
        <result property="name" column="name"/>
        <result property="code" column="code"/>
        <result property="barcode" column="barcode"/>
        <result property="spec" column="spec"/>
        <result property="unit" column="unit"/>
        <result property="drugDose" column="drug_dose"/>
        <result property="agentiaUnit" column="agentia_unit"/>
        <result property="component" column="component"/>
        <result property="indication" column="indication"/>
        <result property="isOtc" column="is_otc"/>
        <result property="drugForm" column="drug_form"/>
        <result property="drugPzwh" column="drug_pzwh"/>
        <result property="drugFrom" column="drug_from"/>
        <result property="drugInstruction" column="drug_instruction"/>
    </resultMap>

    <select id="selectByBarcode" resultMap="MedicineInfoResultMap">
        SELECT * FROM medicine_info WHERE barcode = #{barcode} LIMIT 1
    </select>

    <select id="selectById" resultMap="MedicineInfoResultMap">
        SELECT * FROM medicine_info WHERE id = #{id}
    </select>

    <select id="selectByName" resultMap="MedicineInfoResultMap">
        SELECT * FROM medicine_info WHERE name = #{name} LIMIT 1
    </select>
    
    <select id="selectByNameLike" resultMap="MedicineInfoResultMap">
        SELECT * FROM medicine_info WHERE name LIKE CONCAT('%', #{name}, '%') LIMIT 1
    </select>
</mapper>
